# Copiá este archivo a .env y completá con tus claves reales.
# NUNCA subas un .env real al repositorio.

# Proveedor por defecto: Gemini (gratis en aistudio.google.com/apikey)
GOOGLE_API_KEY=

# Alternativa: OpenAI (definí USE_OPENAI=1 para usarla)
# OPENAI_API_KEY=
# USE_OPENAI=1
# OPENAI_MODEL=gpt-4o-mini

# Modelo de Gemini a utilizar (opcional)
# GOOGLE_MODEL=gemini-flash-latest
