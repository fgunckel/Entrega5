# Copiá este archivo a .env y completá con tus claves reales.
# NUNCA subas un .env real al repositorio (está en .gitignore).

# Proveedor de LLM: "groq" (default del proyecto), "gemini" u "openai"
LLM_PROVIDER=groq

# Clave de Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modelo de Groq a utilizar (opcional; debe soportar tool calling)
# GROQ_MODEL=openai/gpt-oss-120b

# Alternativa: Google Gemini (https://aistudio.google.com/apikey)
# GOOGLE_API_KEY=
# GOOGLE_MODEL=gemini-flash-latest

# Alternativa: OpenAI (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
